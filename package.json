{
  "name": "@papagoose/juke",
  "version": "0.1.0",
  "description": "Checks completed agent turns for unfinished work and sends a scoped follow-up when appropriate.",
  "repository": { "type": "git", "url": "git+https://github.com/papag00se/paseo-juke-plugin.git" },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "npm-shrinkwrap.json",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "!server/*.test.ts",
    "!server/*.test.mjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run server/*.test.ts && node --test server/settings.test.mjs",
    "test:settings": "node --test server/settings.test.mjs",
    "eval": "tsx eval/judge.eval.ts"
  },
  "dependencies": {
    "@getpaseo/protocol": "0.11.2"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.2",
    "@getpaseo/plugin": "0.11.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.1",
    "zod": "^4.4.3"
  }
}
